{
  "name": "miditap",
  "version": "2.0.0",
  "productName": "MIDItap",
  "description": "MIDI tap-tempo generator",
  "main": "index.js",
  "author": "Lennart Clausing",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder -mw",
    "dist": "electron-builder",
    "check:supply-chain": "node scripts/check-release-age.mjs"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.lclausing.miditap",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
